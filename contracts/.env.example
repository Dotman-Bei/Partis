# Copy to contracts/.env (git-ignored) and fill in. Never commit the real file.

# Deployer private key (64 hex characters, 0x prefix optional). Use a fresh wallet that holds only testnet tBOT —
# the deployer has no on-chain privileges after deployment; it only pays gas.
# Get tBOT: https://faucet.botchain.ai/basic (10 tBOT / 24h)
PRIVATE_KEY=

# BOT Chain Testnet RPC (verified from dev-docs.botchain.ai; re-check before deploying)
BOT_TESTNET_RPC=https://rpc.bohr.life

# Public repository URL, shown in the web app footer (optional)
REPO_URL=
